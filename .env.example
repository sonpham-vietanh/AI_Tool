# --- Bắt buộc khi chạy trên server (mở ra ngoài localhost) ---
BTH_ALLOWED_HOSTS=books.example.com
BTH_AUTH_USER=admin
BTH_AUTH_PASSWORD=doi-mat-khau-dai-va-kho-doan

# --- Tùy chọn ---
# Thư mục dữ liệu (cache dịch, jobs.db, settings.json, sách tải về, file xuất ra). Mặc định /data trong Docker.
BTH_DATA_DIR=/data
# Cấu hình LLM mặc định (có thể nhập lại trong giao diện > Cài đặt)
BTH_API_KEY=
BTH_BASE_URL=https://api.openai.com/v1
# Model dịch mặc định và số luồng song song (server công khai khóa cài đặt nên đặt ở đây)
BTH_MODEL=
BTH_CONCURRENCY=12
BTH_DISABLE_AUTH=
